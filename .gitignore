# ======================== Hexive .gitignore ========================

# ----- Java / Maven Backend -----
src/backend/target/
src/backend/.mvn/
src/backend/*.jar
src/backend/*.war
*.class
*.log

# ----- IDE Files -----
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~

# ----- JVM Crash Logs -----
hs_err_pid*.log
replay_pid*.log

# ----- Database Files -----
*.mv.db
*.trace.db
data/

# ----- ESP32 / Arduino Build -----
src/hardware/**/build/
src/hardware/**/*.bin
src/hardware/**/*.elf

# ----- Credentials & Secrets -----
# CRITICAL: Never commit real credentials!
src/hardware/**/Secrets.h
*.pem
*.pem.crt
*.pem.key
.env
*.env.*

# ----- OS Files -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Temporary Files -----
*.tmp
*.bak
*.orig
payload.json
master_queries.sql
